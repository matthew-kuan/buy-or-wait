# Copy to .env and fill in locally, or export the variables in your shell.
# The pipeline reads secrets from the environment only; .env is gitignored.

# Anthropic API key used by code/extraction.py (message classification and image reading).
# Leave unset to run from the disk cache only (python code/main.py --dry-run).
ANTHROPIC_API_KEY=

# Optional: override the model id (default claude-opus-5). Changing it invalidates the cache.
# BUY_OR_WAIT_MODEL=claude-opus-5
