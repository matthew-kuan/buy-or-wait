# Copy to .env and fill in locally, or export the variables in your shell.
# The pipeline reads secrets from the environment only; .env is gitignored.

# Google AI Studio key used by code/extraction.py (message classification and image reading).
# Leave unset to run from the disk cache only (python code/main.py --dry-run).
GEMINI_API_KEY=

# Optional overrides
# BUY_OR_WAIT_MODEL=gemini-3.5-flash     # changing the model invalidates the cache
# GEMINI_RPM=5                           # token-bucket requests per minute (free tier ~5-10)
# GEMINI_THINKING_LEVEL=                 # e.g. low; unset = model default
